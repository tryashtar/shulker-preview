from plugins.util import canon, short
from plugins.info import dye_colors
from plugins.v1 import override_check

length_dict = ctx.meta['shulker_preview']['length_dict']
durability_dict = ctx.meta['shulker_preview']['durability_dict']
item_overrides = ctx.meta['shulker_preview']['item_overrides']
banners_enabled = ctx.meta['shulker_preview']['banners']
patterns = ctx.meta['shulker_preview']['patterns']

def process_item(row: int):
   function f"tryashtar.shulker_preview:render/row_{row}/item":
      execute store result score #length shulker_preview run data get block ~1 1 ~ RecordItem.id
      for length in sorted(length_dict.keys()):
         execute if score #length shulker_preview matches length run function f"tryashtar.shulker_preview:render/row_{row}/item/length_{length}":
            has_durability = False
            has_banner = False
            for item in length_dict[length]:
               durability = durability_dict.get(item)
               for override in item_overrides[item]:
                  pos, neg = override_check(item, override.predicate, durability)
                  if neg is None:
                     execute if block ~1 1 ~ jukebox{RecordItem:pos} run summon area_effect_cloud ~ ~ ~ {Tags:["tryashtar.shulker_preview"],CustomName:f'{{"translate":"tryashtar.shulker_preview.{override.kind}.{override.sprite}.{row}"}}'}
                  else:
                     execute if block ~1 1 ~ jukebox{RecordItem:pos} unless block ~1 1 ~ jukebox{RecordItem:neg} run summon area_effect_cloud ~ ~ ~ {Tags:["tryashtar.shulker_preview"],CustomName:f'{{"translate":"tryashtar.shulker_preview.{override.kind}.{override.sprite}.{row}"}}'}
               if item.endswith('_banner'):
                  has_banner = True
               if durability is not None:
                  has_durability = True
                  execute if block ~1 1 ~ jukebox{RecordItem:{id:item}} run scoreboard players set #max shulker_preview durability
            if banners_enabled:
               if has_banner:
                  execute if data block ~1 1 ~ RecordItem.tag.BlockEntityTag.Patterns[0] run function f"tryashtar.shulker_preview:render/row_{row}/overlay/banner_pattern"
               if "minecraft:shield" in length_dict[length]:
                  execute if data block ~1 1 ~ RecordItem.tag.BlockEntityTag.Base run function f"tryashtar.shulker_preview:render/row_{row}/overlay/shield_base"
                  execute if data block ~1 1 ~ RecordItem.tag.BlockEntityTag.Patterns[0] run function f"tryashtar.shulker_preview:render/row_{row}/overlay/shield_pattern"
            if has_durability:
               execute store result score #durability shulker_preview run data get block ~1 1 ~ RecordItem.tag.Damage
               execute if data block ~1 1 ~ RecordItem.tag.Damage run function f"tryashtar.shulker_preview:render/row_{row}/overlay/durability"
      execute unless entity @e[type=area_effect_cloud,tag=tryashtar.shulker_preview,distance=..0.0001,limit=1] run summon area_effect_cloud ~ ~ ~ {Tags:["tryashtar.shulker_preview"],CustomName:f'{{"translate":"tryashtar.shulker_preview.missingno.{row}"}}'}
      execute store result score #count shulker_preview run data get block ~1 1 ~ RecordItem.Count
      execute if score #count shulker_preview matches 2.. run function f"tryashtar.shulker_preview:render/row_{row}/overlay/count"

def process_count(row: int):
   function f"tryashtar.shulker_preview:render/row_{row}/overlay/count":
      for i in range(2, 65):
         if i < 64:
            n = i
         else:
            n = (i, None)
         execute if score #count shulker_preview matches n run summon area_effect_cloud ~ ~0.2 ~ {Tags:["tryashtar.shulker_preview"],CustomName:f'[{{"translate":"tryashtar.shulker_preview.number_shadow.{i}.{row}","color":"dark_gray"}},", ",{{"translate":"tryashtar.shulker_preview.number.{i}.{row}","color":"white"}}]'}

def process_durability(row: int):
   function f"tryashtar.shulker_preview:render/row_{row}/overlay/durability":
      scoreboard players operation #durability shulker_preview *= #13000 shulker_preview
      scoreboard players operation #durability shulker_preview /= #max shulker_preview
      for i in range(0, 14):
         lower = 1000*i-500
         upper = 1000*i+499
         if i == 13:
            check = (lower, None)
         elif i == 0:
            check = (1, upper)
         else:
            check = (lower, upper)
         execute if score #durability shulker_preview matches check run summon area_effect_cloud ~ ~0.3 ~ {Tags:["tryashtar.shulker_preview"],CustomName:f'{{"translate":"tryashtar.shulker_preview.durability.{i}.{row}"}}'}

def process_banner(row: int):
   function f"tryashtar.shulker_preview:render/row_{row}/overlay/shield_base":
      for index, color in enumerate(dye_colors().keys()):
         execute if data block ~1 1 ~ RecordItem.tag.pattern{Color:index} run summon area_effect_cloud ~ ~ ~ {Tags:["tryashtar.shulker_preview"],CustomName:f'{{"translate":"tryashtar.shulker_preview.overlay.shield.base.{color}.{row}"}}'}
   for kind in ("banner", "shield"):
      function f"tryashtar.shulker_preview:render/row_{row}/overlay/{kind}_pattern":
         data modify block ~1 1 ~ RecordItem.tag.pattern set from block ~1 1 ~ RecordItem.tag.BlockEntityTag.Patterns[0]
         for index, color in enumerate(dye_colors().keys()):
            execute if data block ~1 1 ~ RecordItem.tag.pattern{Color:index} run function f"tryashtar.shulker_preview:render/row_{row}/overlay/{kind}_pattern/{color}":
               for code, pattern in patterns.items():
                  execute if data block ~1 1 ~ RecordItem.tag.pattern{Pattern:code} run summon area_effect_cloud ~ ~ ~ {Tags:["tryashtar.shulker_preview"],CustomName:f'{{"translate":"tryashtar.shulker_preview.overlay.{kind}.{pattern}.{color}.{row}"}}'}
         data remove block ~1 1 ~ RecordItem.tag.BlockEntityTag.Patterns[0]
         execute if data block ~1 1 ~ RecordItem.tag.BlockEntityTag.Patterns[0] positioned ~ ~0.01 ~ run function f"tryashtar.shulker_preview:render/row_{row}/overlay/{kind}_pattern"

for row in range(3):
   process_item(row)
   process_count(row)
   process_durability(row)
   if banners_enabled:
      process_banner(row)
